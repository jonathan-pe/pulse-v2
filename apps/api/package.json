{
  "name": "@pulse/api",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse API (Fastify)",
  "type": "module",
  "main": "plugin.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test \"dist-test/test/**/*.test.js\"",
    "start": "npm run build:ts && fastify start -l info dist/plugin.js",
    "build": "tsc",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "check-types": "tsc --noEmit",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/plugin.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@fastify/sensible": "^6.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pulse/shared": "workspace:*",
    "@vercel/functions": "^3.9.1",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2",
    "undici-types": "^7.24.6"
  }
}