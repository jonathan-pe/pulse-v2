{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm turbo build --filter=@pulse/web"
    },
    "api": {
      "root": "apps/api/",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm turbo build --filter=@pulse/api"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
